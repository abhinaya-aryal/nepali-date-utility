{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nepali-date-utility",
  "version": "2.0.0",
  "description": "Zero-dependency Nepali Bikram Sambat (BS) date library with accessible React DatePicker components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "cd example && vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "add-year": "bun scripts/manage-calendar-year.ts add",
    "remove-year": "bun scripts/manage-calendar-year.ts remove",
    "prepare": "bun run build"
  },
  "keywords": [
    "nepali",
    "date-picker",
    "bikram-sambat",
    "bs",
    "calendar",
    "react",
    "tailwindcss",
    "nepali-date",
    "nepali-date-utility"
  ],
  "author": "Abhinaya Aryal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinaya-aryal/nepali-date-utility.git"
  },
  "homepage": "https://date.aryalabhinaya.com.np",
  "bugs": {
    "url": "https://github.com/abhinaya-aryal/nepali-date-utility/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
